# Copy to .env next to docker-compose.yml. Keep .env out of version control.

# Password for the web UI. Use something long; it is the only thing between
# the internet and your provider credentials.
CHECKLISTS_ADMIN_PASSWORD=change-me

# The HTTPS URL your reverse proxy serves for the bridge. Cosmetic only: it is
# what the web UI tells you to type into Garmin Connect.
CHECKLISTS_PUBLIC_URL=https://checklists.example.com

# IPs/CIDRs, comma-separated, whose X-Forwarded-* headers to believe. Docker's
# default bridge range is a workable starting point; narrow it to your proxy's
# actual address once you know it (see docs/bridge.md). Leaving this unset
# trusts only 127.0.0.1, which a containerized proxy never is.
CHECKLISTS_TRUSTED_PROXIES=172.16.0.0/12

# Only needed if you switch the data volume to a bind mount: the host user that
# owns the directory, so the container can write to it. `id -u` and `id -g`.
# With the default named volume, leave these alone.
PUID=10001
PGID=10001
